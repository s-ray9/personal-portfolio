---
import NavItems from "@components/navigation/NavItems.astro";
import Divider from "@components/ui/Divider.astro";
import { siteConfig } from "@config/site";

const { name: siteName, startYear: siteStartYear } = siteConfig;

const currentDate = new Date();
const currentYear = currentDate.getFullYear();

const copyrightTimeline =
  siteStartYear === currentYear
    ? `${currentYear}`
    : `${siteStartYear}–${currentYear}`;
---

<footer class="w-full">
  <Divider class="w-full" />

  <div class="p-footer-padding">
    <div
      class="mx-auto flex w-full max-w-7xl flex-col items-center gap-4 text-center sm:flex-row sm:justify-between"
    >
      <p class="text-xs text-fg-secondary">
        {`© ${copyrightTimeline} ${siteName}`}
      </p>

      <nav aria-label="Secondary">
        <div class="flex flex-wrap items-center justify-center gap-4">
          <NavItems
            items={siteConfig.navigation.footer}
            itemClass="p-2 rounded-lg text-fg-secondary hover:text-fg-primary text-sm font-medium tracking-tight hover:text-shadow-accent"
          />
        </div>
      </nav>
    </div>
  </div>
</footer>
