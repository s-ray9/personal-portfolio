---
import { siteConfig } from "@config/site";

import Logo from "@components/branding/Logo.astro";
import NavItems from "@components/navigation/NavItems.astro";
import Primitive from "@components/ui/Primitive.astro";
import StatusDot from "@components/ui/StatusDot.astro";
---

<header
  class="pointer-events-none fixed inset-x-page-gutter top-page-gutter z-sticky flex justify-center"
>
  <nav
    class="pointer-events-auto flex min-h-header-height w-full max-w-7xl items-center justify-between surface-glass px-container-padding text-sm font-medium tracking-tight whitespace-nowrap"
    aria-label="Main"
  >
    <Primitive
      as="a"
      href="/"
      class="inline-flex items-center gap-4 rounded-lg p-2 text-fg-primary text-shadow-accent"
      aria-current={Astro.url.pathname === "/" ? "page" : undefined}
    >
      <Logo class="size-6 scheme-dark" />
      {siteConfig.name}
      <StatusDot />
    </Primitive>

    <div class="flex items-center gap-4">
      <ul class="hidden gap-4 md:flex">
        <NavItems
          items={siteConfig.navigation.main}
          itemClass="p-2 rounded-lg text-fg-secondary hover:text-fg-primary hover:text-shadow-accent"
        />
      </ul>

      <Primitive
        as="button"
        type="button"
        data-menu-trigger
        class="rounded-lg p-2 text-fg-secondary hover:text-fg-primary hover:text-shadow-accent md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
      >
        Menu
      </Primitive>
    </div>
  </nav>
</header>
