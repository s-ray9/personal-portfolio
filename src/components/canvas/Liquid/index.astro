<div class="webgl-viewport-wrapper">
  <canvas id="experience-canvas"></canvas>
</div>

<script>
  import { Pipeline } from "./pipeline";

  document.addEventListener("DOMContentLoaded", () => {
    const canvas = document.getElementById(
      "experience-canvas",
    ) as HTMLCanvasElement | null;
    if (canvas) {
      new Pipeline(canvas);
    }
  });
</script>

<style>
  .webgl-viewport-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
    background-color: var(--color-bg-primary);
  }
  #experience-canvas {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
