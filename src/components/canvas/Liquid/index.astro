<canvas
  id="liquid-canvas"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10 size-full bg-(--color-bg-primary)"
></canvas>

<script>
  import { LiquidBackground } from "./liquid";

  const canvas = document.querySelector<HTMLCanvasElement>("#liquid-canvas");

  if (canvas) {
    try {
      new LiquidBackground(canvas);
    } catch (error) {
      console.warn("Liquid background disabled:", error);
    }
  }
</script>
