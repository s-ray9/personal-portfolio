---
import { cn } from "@utils/cn";
import type { HTMLTag, Polymorphic } from "astro/types";

type Props<Tag extends HTMLTag = "a"> = Polymorphic<{
  as: Tag;
}>;

const { as: Tag = "a", class: className, ...props } = Astro.props;

const baseStyles =
  "cursor-pointer outline-hidden transition-all duration-150 ease-out focus-visible:ring-2 focus-visible:ring-fg-primary focus-visible:text-fg-primary focus-visible:text-shadow-accent";
---

<Tag {...props} class={cn(baseStyles, className)}>
  <slot />
</Tag>
