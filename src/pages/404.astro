---
import Primitive from "@components/ui/Primitive.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout title="404 Not Found">
  <section class="flex flex-1 flex-col items-center justify-center gap-4 text-center">
    <h1 class="uppercase">
      <span class="block text-shadow-accent">404</span>
      <span class="mt-2 block text-sm tracking-widest text-fg-secondary">
        Not Found
      </span>
    </h1>

    <p class="max-w-md text-fg-secondary">
      Sorry, we couldn't find the page you were looking for.
    </p>

    <Primitive
      as="a"
      href="/"
      class="button px-6 py-3 text-fg-secondary hover:text-fg-primary hover:text-shadow-accent"
    >
      Go Home
    </Primitive>
  </section>
</Layout>
