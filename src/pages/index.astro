---
import { siteConfig } from "@config/site";
import Layout from "@layouts/Layout.astro";
---

<Layout>
  <section
    class="flex flex-1 flex-col items-center justify-center gap-4 text-center"
  >
    <h1>{siteConfig.name}</h1>
    <p class="text-lg">Systems developer and game developer.</p>
    <p class="max-w-xl">
      Hi, I’m {siteConfig.developer.preferredName}. I build Roblox frameworks
      and games, simulations, and machine learning research tools. Right now I’m
      building a tank game with shadow projection.
    </p>
  </section>
</Layout>
