---
import "@fontsource/inter/400.css";
import "@fontsource/orbitron/900.css";
import "@styles/global.css";

import { type ImageInfo, siteConfig } from "@config/site";

import Liquid from "@components/canvas/Liquid/index.astro";
import Footer from "@components/layout/Footer.astro";
import Header from "@components/layout/Header.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: ImageInfo;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  ogImage = siteConfig.ogImage,
} = Astro.props;

const baseSiteUrl = Astro.site?.href ?? "http://localhost:4321";
const canonicalUrl = new URL(Astro.url.pathname, baseSiteUrl);
const ogImageUrl = ogImage.src.startsWith("http")
  ? new URL(ogImage.src)
  : new URL(ogImage.src, baseSiteUrl);
---

<!doctype html>
<html lang={siteConfig.lang} class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta name="apple-mobile-web-app-title" content={siteConfig.name} />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImage.alt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>

  <body class="isolate flex flex-col">
    <Liquid />

    <Header />

    <main
      class="flex w-full flex-1 justify-center px-page-gutter py-page-spacing pt-header-clearance"
    >
      <div class="flex w-full max-w-7xl flex-1 flex-col">
        <slot />
      </div>
    </main>

    <Footer />
  </body>
</html>
